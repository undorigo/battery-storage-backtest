{
  // Click-to-run versions of the justfile recipes.
  //
  // These delegate to just rather than repeating the commands, so there is one
  // source of truth. The justfile is the canonical interface; this only adds a
  // menu inside the editor for anyone who would rather click than type.
  //
  // Run with Cmd+Shift+P -> "Tasks: Run Task", or Cmd+Shift+B for the default.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "test",
      "detail": "Offline contract tests — no network, no token",
      "type": "shell",
      "command": "just test",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "verify",
      "detail": "Check the forecast series really are forecasts — needs network and token",
      "type": "shell",
      "command": "just verify",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "setup",
      "detail": "Recreate the venv and install pinned dependencies",
      "type": "shell",
      "command": "just setup",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "clean",
      "detail": "Clear __pycache__ and .pytest_cache — leaves data and the venv alone",
      "type": "shell",
      "command": "just clean",
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    }
  ]
}
